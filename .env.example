# ───────────────────────────────────────────────────────────────
# [PRODUCT_NAME] — environment variables
# Copy this file to .env.local and fill in the real values.
# NEVER commit .env.local.
# ───────────────────────────────────────────────────────────────

# Supabase — project URL and keys (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SERVER ONLY. Used by route handlers that bypass RLS
# for background enrichment writes. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ── AI provider (pluggable). Pick ONE. ──────────────────────────
# If OPENROUTER_API_KEY is set, the app uses OpenRouter; otherwise Gemini.

# Option A — OpenRouter (recommended): one cheap multimodal model covers
# both text enrichment and photo identification. SERVER ONLY.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Option B — Google Gemini (Flash) direct. SERVER ONLY.
# Needs a key with free-tier (or billing) at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Optional: UPC lookup provider key. UPCitemdb trial works WITHOUT a key.
UPC_LOOKUP_API_KEY=

# App base URL — used as attribution header for OpenRouter.
# In local dev: http://localhost:3000 . In prod: your deployed origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000
